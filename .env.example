# Variables compartidas por docker-compose (via env_file) para todos los servicios.
# Copia este archivo como .env y completa los valores reales. Nunca commitees .env.

# --- Auth / JWT (compartido entre los 6 servicios) ---
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=

# --- URLs internas entre servicios (backend) ---
AUTH_SERVICE_URL=http://localhost:8086
CLIENTES_SERVICE_URL=http://localhost:8081
HABITACIONES_SERVICE_URL=http://localhost:8082
RESERVAS_SERVICE_URL=http://localhost:8083
FACTURACION_SERVICE_URL=http://localhost:8084
EMPLEADOS_SERVICE_URL=http://localhost:8085

# --- URLs consumidas por el frontend (Vite) ---
VITE_API_URL=http://localhost:8086
VITE_AUTH_SERVICE_URL=http://localhost:8086
VITE_CLIENTES_SERVICE_URL=http://localhost:8081
VITE_HABITACIONES_SERVICE_URL=http://localhost:8082
VITE_RESERVAS_SERVICE_URL=http://localhost:8083
VITE_FACTURACION_SERVICE_URL=http://localhost:8084
VITE_EMPLEADOS_SERVICE_URL=http://localhost:8085

# --- CORS (lista JSON de orígenes permitidos) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:3001"]

# --- General ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
AUTH_ENABLED=true
